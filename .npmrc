; The devDependencies pin @deepseek-ai packages to the host closure wave
; (types-only devDeps). Their cross-package exact peer pins cannot be
; reconciled by npm's modern resolver while the tree still holds the previous
; wave, so keep npm v6 peer semantics (same as dsh-llm-proxy / dsh-vault).
legacy-peer-deps=true
auto-install-peers=false
